# ===== Database =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=campusconnect
DB_USER=root
DB_PASSWORD=

# ===== CampusConnect AI =====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ===== Persistent media storage (recommended for production) =====
STORAGE_ENABLED=false
STORAGE_ENDPOINT=
STORAGE_BUCKET=campusconnect-media
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=us-east-1
STORAGE_PUBLIC_BASE_URL=

# ===== System accounts =====
SYSTEM_ACCOUNTS_ENABLED=true
SYSTEM_OFFICIAL_PASSWORD=
SYSTEM_ADMIN_PASSWORD=
